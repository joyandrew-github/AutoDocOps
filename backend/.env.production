# Production Environment Configuration
# Copy to .env and fill in real values

APP_NAME=AutoDocOps
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=production

# PostgreSQL
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=autodocops
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=autodocops

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_DB=0

# Security — MUST change in production
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["https://autodocops.example.com"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# Celery
CELERY_BROKER_URL=redis://:CHANGE_ME_STRONG_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_STRONG_PASSWORD@redis:6379/0

# Observability
OTEL_EXPORTER_ENDPOINT=http://otel-collector:4317
OTEL_ENABLED=true
PROMETHEUS_ENABLED=true

# Logging
LOG_LEVEL=INFO
